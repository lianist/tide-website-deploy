# Supabase — 값은 `supabase projects api-keys --project-ref <ref>` 또는 대시보드에서
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 테스트 하네스뿐 아니라 런타임도 쓴다(앱 로그인 코드 발급, lib/supabase/admin.ts) — 배포 환경에도 필요
SUPABASE_SECRET_KEY=
# 로컬 Supabase CLI 전용(`db push`·`db:types`). 코드가 읽지 않으므로 배포 환경에는 넣지 않는다
SUPABASE_DB_PASSWORD=

# LLM — 프로바이더는 OpenAI. 읽는 곳은 lib/llm/openai.ts 한 곳. 모델·비용은 docs/03-Architecture.md §설계 결정 4
OPENAI_API_KEY=
# 본부 지원 게이트웨이(AWS Bedrock, OpenAI 호환). 키가 있으면 OpenAI 대신 이쪽으로 보낸다 — 빼면 롤백
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
